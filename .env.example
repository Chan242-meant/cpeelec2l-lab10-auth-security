# Local MySQL
DATABASE_URL=mysql://user:password@localhost:3306/dbname
DATABASE_SSL=false

# TiDB Cloud Serverless (production)
# DATABASE_URL=mysql://user:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/dbname
# DATABASE_SSL=true

PORT=5000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
GIT_COMMIT_SHA=local
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
